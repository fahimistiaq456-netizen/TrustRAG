# ---------------------------------------------------------------------------
# Hallufix environment configuration (copy to .env and adjust as needed).
# All values below are prefixed with HALLUFIX_ and read by backend/config.py.
# Never commit real secrets; this file contains only safe dev defaults.
# ---------------------------------------------------------------------------

# --- Core / retrieval ---
# Directory where the FAISS index, metadata and graph are persisted.
HALLUFIX_INDEX_DIR=data/index

# Minimum similarity for the abstention gate (0.0 - 1.0).
HALLUFIX_ABSTENTION_THRESHOLD=0.25

# --- Ollama (local LLM) ---
HALLUFIX_OLLAMA_HOST=http://127.0.0.1:11434
HALLUFIX_OLLAMA_MODEL=llama3.2:3b

# --- Phase 1: Cross-encoder reranking ---
HALLUFIX_RERANKER_ENABLED=false
HALLUFIX_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
HALLUFIX_RERANK_CANDIDATES=10
HALLUFIX_RERANK_TOP_N=5
# Minimum reranker score to keep a chunk; leave very low (e.g. -10) to not filter.
HALLUFIX_RERANK_MIN_SCORE=-10.0

# --- Phase 2: NLI verification ---
HALLUFIX_NLI_ENABLED=false
HALLUFIX_NLI_MODEL=cross-encoder/nli-MiniLM2-L6-H768
HALLUFIX_NLI_ENTAILMENT_THRESHOLD=0.70
HALLUFIX_NLI_CONTRADICTION_THRESHOLD=0.70

# --- Phase 4: Graph-based retrieval ---
HALLUFIX_GRAPH_ENABLED=false
# Number of adjacent graph nodes expanded per retrieved seed chunk.
HALLUFIX_GRAPH_NEIGHBORS=4

# --- Phase 6: Authentication / RBAC ---
HALLUFIX_AUTH_ENABLED=false
# IMPORTANT: override with a long random value !!! in production. Never commit a
# real secret. `python -c "import secrets; print(secrets.token_hex(32))"`.
HALLUFIX_JWT_SECRET=change-me-in-production
HALLUFIX_ACCESS_TOKEN_EXPIRE_MINUTES=60
HALLUFIX_DB_PATH=data/hallufix.db

# --- CORS for the Next.js webapp ---
HALLUFIX_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000